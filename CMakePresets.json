{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "cpu-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "cpu-debug",
      "inherits": "cpu-base",
      "displayName": "CPU Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "cpu-release",
      "inherits": "cpu-base",
      "displayName": "CPU Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "cpu-asan",
      "inherits": "cpu-base",
      "displayName": "CPU Debug, ASan+UBSan, quant only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DF_SANITIZE": "ON",
        "DF_TEST_SCOPE": "quant"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "cpu-asan", "configurePreset": "cpu-asan" }
  ],
  "testPresets": [
    {
      "name": "cpu-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "cpu-debug", "inherits": "cpu-base", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "inherits": "cpu-base", "configurePreset": "cpu-release" },
    {
      "name": "cpu-asan",
      "inherits": "cpu-base",
      "configurePreset": "cpu-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:exitcode=86",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}
