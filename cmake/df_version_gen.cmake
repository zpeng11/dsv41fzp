# Script mode: cmake -DSOURCE_DIR=... -DGIT_EXECUTABLE=... -DOUTPUT=... -P df_version_gen.cmake
#
# dirty = tracked changes (staged or not) or untracked files not covered by
# .gitignore. Outside a Git work tree the build fails instead of guessing.

foreach(_var IN ITEMS SOURCE_DIR GIT_EXECUTABLE OUTPUT)
  if(NOT DEFINED ${_var} OR "${${_var}}" STREQUAL "")
    message(FATAL_ERROR "df_version_gen: ${_var} is required")
  endif()
endforeach()

file(READ "${SOURCE_DIR}/VERSION" _base)
string(STRIP "${_base}" _base)
if(NOT _base MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "df_version_gen: VERSION '${_base}' is not <major>.<minor>.<patch>")
endif()

execute_process(
  COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
  OUTPUT_VARIABLE _toplevel OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE _rc ERROR_QUIET)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "df_version_gen: ${SOURCE_DIR} is not a Git work tree; refusing to fabricate SHA/dirty")
endif()
file(REAL_PATH "${_toplevel}" _toplevel)
file(REAL_PATH "${SOURCE_DIR}" _source)
if(NOT _toplevel STREQUAL _source)
  message(FATAL_ERROR "df_version_gen: Git top-level '${_toplevel}' is not the source dir '${_source}'")
endif()

execute_process(
  COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
  OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "df_version_gen: cannot resolve HEAD")
endif()

execute_process(
  COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal
  OUTPUT_VARIABLE _status
  RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "df_version_gen: git status failed")
endif()

if(_status STREQUAL "")
  set(_dirty 0)
  set(_display "${_base}")
else()
  set(_dirty 1)
  set(_display "${_base}+dirty")
endif()

set(_content "#pragma once
// Generated by cmake/df_version_gen.cmake; do not edit.
#define DF_VERSION_BASE \"${_base}\"
#define DF_GIT_SHA \"${_sha}\"
#define DF_GIT_DIRTY ${_dirty}
#define DF_VERSION_STRING \"${_display}\"
")

get_filename_component(_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
file(WRITE "${OUTPUT}.tmp" "${_content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
